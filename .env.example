# ─── Binance Testnet Credentials ───────────────────────────────────────────────
# Get yours at: https://testnet.binance.vision/
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# ─── Bot Settings ───────────────────────────────────────────────────────────────
SYMBOL=BTC/USDT          # Trading pair
TIMEFRAME=1h             # Candle timeframe: 1m 5m 15m 1h 4h 1d
TRADE_AMOUNT_USDT=50     # USDT to risk per trade
MAX_OPEN_TRADES=3        # Max concurrent positions
STOP_LOSS_PCT=2.0        # Stop loss % below entry
TAKE_PROFIT_PCT=4.0      # Take profit % above entry

# ─── ML Model Settings ──────────────────────────────────────────────────────────
LOOKBACK_CANDLES=200     # Candles used for training/features
RETRAIN_EVERY_N=50       # Retrain model every N new candles
MIN_SIGNAL_CONFIDENCE=0.6 # Min probability to act on signal (0–1)

# ─── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
TRADE_LOG_FILE=logs/trades.csv
