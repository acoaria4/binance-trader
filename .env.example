# ─── Binance Testnet Credentials ────────────────────────────────────────────────
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# ─── Bot Settings ────────────────────────────────────────────────────────────────
SYMBOL=BTC/USDT
TIMEFRAME=1h
TRADE_AMOUNT_USDT=50
MAX_OPEN_TRADES=3
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=5.0
TRAIL_ACTIVATE_PCT=1.0
TRAIL_DISTANCE_PCT=1.5
FORWARD_CANDLES=10

# ─── Execution Costs (backtest + EV) ───────────────────────────────────────────
FEE_PCT=0.10
SLIPPAGE_PCT=0.05

# ─── ML Model Settings ───────────────────────────────────────────────────────────
LOOKBACK_CANDLES=200
RETRAIN_EVERY_N=50
MIN_SIGNAL_CONFIDENCE=0.62

# ─── High-Conviction Entry Gates ─────────────────────────────────────────────────
EV_MIN=0.005
P_WIN_MIN=0.55
CONVICTION_MIN=0.65

# ─── Regime + Multi-Timeframe Filters ──────────────────────────────────────────
ADX_THRESHOLD=20.0
MIN_ATR_RATIO=0.8
REQUIRE_TREND=true
REQUIRE_MTF=true
MTF_TIMEFRAME=4h
MTF_MIN_EMA_ALIGN=1
MTF_MIN_PRICE_VS_EMA200=-0.02
MTF_MIN_ADX=15.0

# ─── ML Retrain Gate ──────────────────────────────────────────────────────────────
RETRAIN_MIN_F1=0.25
RETRAIN_MIN_VAL_RETURN_PCT=0.0
RETRAIN_MIN_VAL_SHARPE=0.0

# ─── Phase 2: Risk Sizing & Portfolio Controls ───────────────────────────────────
USE_RISK_SIZING=true
RISK_PCT_PER_TRADE=0.5
MAX_POSITION_USDT=200
MAX_PORTFOLIO_HEAT_PCT=2.0
DAILY_LOSS_LIMIT_PCT=3.0
ENTRY_HALT_HOURS=24
CONSECUTIVE_LOSS_LIMIT=3
CONSECUTIVE_LOSS_SIZE_FACTOR=0.5
PORTFOLIO_STATE_FILE=logs/portfolio_state.json

# ─── Phase 2: ATR-Based Dynamic Barriers ─────────────────────────────────────────
USE_ATR_STOPS=true
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0
ATR_TRAIL_MULT=1.5
MIN_STOP_LOSS_PCT=0.8
MAX_STOP_LOSS_PCT=4.0
MIN_TAKE_PROFIT_PCT=2.0
MAX_TAKE_PROFIT_PCT=12.0
MIN_TRAIL_DISTANCE_PCT=0.5

# ─── Phase 3: Execution Fidelity ─────────────────────────────────────────────────
USE_LIMIT_ORDERS=true
MAX_SPREAD_PCT=0.15
LIMIT_ORDER_OFFSET_PCT=0.02
LIMIT_ORDER_TIMEOUT_SEC=30
LIMIT_FALLBACK_TO_MARKET=true
USE_LIMIT_EXITS=false
RECONCILE_ON_START=true
RECONCILE_EVERY_N_LOOPS=10
CANCEL_STALE_ORDERS_SEC=300

# ─── Persistence & Logging ───────────────────────────────────────────────────────
POSITIONS_FILE=logs/positions.json
SIGNAL_LOG_FILE=logs/signals.csv
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
TRADE_LOG_FILE=logs/trades.csv
