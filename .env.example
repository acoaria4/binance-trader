# ─── Binance Testnet Credentials ────────────────────────────────────────────────
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# ─── Bot Settings ────────────────────────────────────────────────────────────────
SYMBOL=BTC/USDT
TIMEFRAME=1h
TRADE_AMOUNT_USDT=50
MAX_OPEN_TRADES=3
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=5.0

# ─── ML Model Settings ───────────────────────────────────────────────────────────
LOOKBACK_CANDLES=200
RETRAIN_EVERY_N=50
MIN_SIGNAL_CONFIDENCE=0.62

# ─── Regime Filter ────────────────────────────────────────────────────────────────
ADX_THRESHOLD=20.0
MIN_ATR_RATIO=0.8
REQUIRE_TREND=true

# ─── ML Retrain Gate ──────────────────────────────────────────────────────────────
RETRAIN_MIN_F1=0.30

# ─── Position Persistence ─────────────────────────────────────────────────────────
POSITIONS_FILE=logs/positions.json

# ─── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
TRADE_LOG_FILE=logs/trades.csv
