# ─── Binance Testnet Credentials ────────────────────────────────────────────────
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# ─── Bot Settings ────────────────────────────────────────────────────────────────
SYMBOL=BTC/USDT
TIMEFRAME=1h
TRADE_AMOUNT_USDT=50
MAX_OPEN_TRADES=3
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=5.0
TRAIL_ACTIVATE_PCT=1.0
TRAIL_DISTANCE_PCT=1.5
FORWARD_CANDLES=10

# ─── Execution Costs (backtest + EV) ───────────────────────────────────────────
FEE_PCT=0.10
SLIPPAGE_PCT=0.05

# ─── ML Model Settings ───────────────────────────────────────────────────────────
LOOKBACK_CANDLES=200
RETRAIN_EVERY_N=50
MIN_SIGNAL_CONFIDENCE=0.62

# ─── High-Conviction Entry Gates ─────────────────────────────────────────────────
EV_MIN=0.005
P_WIN_MIN=0.55
CONVICTION_MIN=0.65

# ─── Regime + Multi-Timeframe Filters ──────────────────────────────────────────
ADX_THRESHOLD=20.0
MIN_ATR_RATIO=0.8
REQUIRE_TREND=true
REQUIRE_MTF=true
MTF_TIMEFRAME=4h
MTF_MIN_EMA_ALIGN=1
MTF_MIN_PRICE_VS_EMA200=-0.02
MTF_MIN_ADX=15.0

# ─── ML Retrain Gate ──────────────────────────────────────────────────────────────
RETRAIN_MIN_F1=0.25
RETRAIN_MIN_VAL_RETURN_PCT=0.0
RETRAIN_MIN_VAL_SHARPE=0.0

# ─── Persistence & Logging ───────────────────────────────────────────────────────
POSITIONS_FILE=logs/positions.json
SIGNAL_LOG_FILE=logs/signals.csv
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
TRADE_LOG_FILE=logs/trades.csv
